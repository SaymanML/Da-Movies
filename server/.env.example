# Port for Express API server
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local mongod)
# Example: mongodb://localhost:27017/damovies or mongodb+srv://<user>:<password>@cluster.mongodb.net/damovies
MONGODB_URI=

# TMDB v3 API Key (Get free key at https://www.themoviedb.org/settings/api)
# Note: Either TMDB_API_KEY (v3 key) or TMDB_BEARER_TOKEN (v4 Read Access Token) works!
TMDB_API_KEY=

# Default Region for streaming watch providers (ISO 3166-1 alpha-2, e.g. IN, US, GB)
DEFAULT_REGION=IN
